    req_ip = urllib.request.urlopen('https://ipinfo.io/json', timeout=5)
    data_ip = json.loads(req_ip.read().decode('utf8'))
    public_ip = data_ip.get('ip', 'TIDAK_DIKETAHUI')
    city = data_ip.get('city', 'Unknown')
    country = data_ip.get('country', 'Unknown')
    org = data_ip.get('org', 'Unknown').split(' ', 1)[-1]
    server_location = f"{city}, {country} ({org})"
