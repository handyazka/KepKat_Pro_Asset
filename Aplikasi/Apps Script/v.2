// ==============================================================================
// FUNGSI BANTUAN: BUAT TAB, HEADER, WARNA ZEBRA & LEBAR KOLOM
// ==============================================================================
function dapatkanAtauBuatTab(namaTab, headerArray) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(namaTab);
  
  if (!sheet) { 
    sheet = ss.insertSheet(namaTab); 
    if(namaTab === TAB_DASBOR) {
       ss.setActiveSheet(sheet);
       ss.moveActiveSheet(1); 
    }
  }
 
  if (namaTab === TAB_DASBOR) sheet.setTabColor("#6aa84f");
  else if (namaTab === TAB_BLOKIR) sheet.setTabColor("#ff0000"); 
  else if (namaTab === TAB_UTAMA || namaTab === TAB_LOGIN) sheet.setTabColor("#f1c232"); 
  else if (namaTab === TAB_APLIKASI || namaTab === TAB_BULANAN || namaTab === TAB_PERMANEN || namaTab === TAB_KEPKAT_PERMANEN || namaTab === TAB_RIWAYAT) sheet.setTabColor("#38761d"); 
  else if (namaTab === TAB_GRATIS) sheet.setTabColor("#00ffff"); 
  else sheet.setTabColor("#999999");

  if (sheet.getLastRow() === 0 && headerArray && namaTab !== TAB_DASBOR) {
    sheet.appendRow(headerArray);
    var maxCols = headerArray.length;
    var headerRange = sheet.getRange(1, 1, 1, maxCols);
    headerRange.setFontColor("#ffffff").setFontWeight("bold").setVerticalAlignment("middle").setWrap(true);
    sheet.setRowHeight(1, 40); 

    if (namaTab !== TAB_LOGIN) {
      var rangeBanding = sheet.getRange(1, 1, 1000, maxCols);
      if (namaTab === TAB_UTAMA) rangeBanding.applyRowBanding(SpreadsheetApp.BandingTheme.INDIGO, true, false);
      else if (namaTab === TAB_BLOKIR) rangeBanding.applyRowBanding(SpreadsheetApp.BandingTheme.PINK, true, false);
      else if (namaTab === TAB_GRATIS) rangeBanding.applyRowBanding(SpreadsheetApp.BandingTheme.CYAN, true, false);
      else if (namaTab === TAB_ERROR) rangeBanding.applyRowBanding(SpreadsheetApp.BandingTheme.LIGHT_GREY, true, false);
      else rangeBanding.applyRowBanding(SpreadsheetApp.BandingTheme.GREEN, true, false);
    }

    if (namaTab === TAB_UTAMA) headerRange.setBackground("#20124d");
    else if (namaTab === TAB_BLOKIR) headerRange.setBackground("#990000"); 
    else if (namaTab === TAB_GRATIS) headerRange.setBackground("#0b5394"); 
    else if (namaTab === TAB_LOGIN) headerRange.setBackground("#1155cc"); 
    else if (namaTab === TAB_ERROR) headerRange.setBackground("#666666"); 
    else headerRange.setBackground("#38761d");
    
    if (namaTab === TAB_UTAMA) {
      sheet.setColumnWidth(1, 50); sheet.setColumnWidth(2, 200); sheet.setColumnWidth(3, 280); sheet.setColumnWidth(4, 180); sheet.setColumnWidth(5, 200); sheet.setColumnWidth(6, 200); sheet.setColumnWidth(7, 200);
    } else if (namaTab === TAB_BLOKIR) {
      sheet.setColumnWidth(1, 50); sheet.setColumnWidth(2, 300); sheet.setColumnWidth(3, 400); 
    } else if (namaTab === TAB_GRATIS) {
      sheet.setColumnWidth(1, 50); sheet.setColumnWidth(2, 300); sheet.setColumnWidth(3, 400);
    } else if (namaTab === TAB_LOGIN) {
      sheet.setColumnWidth(1, 50); sheet.setColumnWidth(2, 200); sheet.setColumnWidth(3, 280); sheet.setColumnWidth(4, 250); sheet.setColumnWidth(5, 150); sheet.setColumnWidth(6, 200); sheet.setColumnWidth(7, 250); sheet.setColumnWidth(8, 150); sheet.setColumnWidth(9, 300); sheet.setColumnWidth(10, 150);
    } else if (namaTab === TAB_ERROR) {
      sheet.setColumnWidth(1, 50); sheet.setColumnWidth(2, 200); sheet.setColumnWidth(3, 200); sheet.setColumnWidth(4, 500);
    } else if (namaTab === TAB_RIWAYAT) {
      sheet.setColumnWidth(1, 50); sheet.setColumnWidth(2, 200); sheet.setColumnWidth(3, 280); sheet.setColumnWidth(4, 400); sheet.setColumnWidth(5, 200);
    } else if (namaTab === TAB_APLIKASI || namaTab === TAB_BULANAN) {
      sheet.setColumnWidth(1, 50); sheet.setColumnWidth(2, 280); sheet.setColumnWidth(3, 200); sheet.setColumnWidth(4, 200); sheet.setColumnWidth(5, 180);
    } else if (namaTab === TAB_PERMANEN || namaTab === TAB_KEPKAT_PERMANEN) {
      sheet.setColumnWidth(1, 50); sheet.setColumnWidth(2, 280); sheet.setColumnWidth(3, 200); sheet.setColumnWidth(4, 180);
    } else if (namaTab === TAB_LAINNYA) {
      sheet.setColumnWidth(1, 50); sheet.setColumnWidth(2, 280); sheet.setColumnWidth(3, 400); sheet.setColumnWidth(4, 200);
    }
  }

  if (namaTab === TAB_DASBOR && sheet.getLastRow() === 0) {
    sheet.setColumnWidth(1, 30); 
    sheet.setColumnWidth(2, 300); 
    sheet.setColumnWidth(3, 200);
    
    sheet.getRange("B2").setValue("STATUS APLIKASI:").setFontWeight("bold").setBackground("#fff2cc");
    var selSaklar = sheet.getRange("C2");
    selSaklar.setValue("BERBAYAR").setFontWeight("bold").setBackground("#d9ead3").setHorizontalAlignment("center");
    var aturanDropdown = SpreadsheetApp.newDataValidation().requireValueInList(["GRATIS", "BERBAYAR"], true).build();
    selSaklar.setDataValidation(aturanDropdown);

    sheet.getRange("B4").setValue("DASBOR STATISTIK KEPKAT KLIPPER").setFontWeight("bold").setFontSize(14).setBackground("#274e13").setFontColor("#ffffff");
    sheet.getRange("B4:C4").merge();
    
    var labelMetrik = [
      ["Total Akun Login"], ["Pembeli KepKat Permanen"], ["Pembeli Aplikasi"], ["Pembeli Bulanan"], ["Pembeli Permanen"], ["Akun Gratis"], ["Akun Terblokir"] 
    ];
    
    var rumusMetrik = [
      ["=COUNTA('Data Ping'!C2:C)"], 
      ["=COUNTIF('Pusat Data'!D2:D; \"KepKat Permanen\")"], 
      ["=COUNTIF('Pusat Data'!D2:D; \"Aplikasi\")"], 
      ["=COUNTIF('Pusat Data'!D2:D; \"Bulanan\")"], 
      ["=COUNTIF('Pusat Data'!D2:D; \"Permanen\")"], 
      ["=COUNTA('Akses Gratis'!B2:B)"], 
      ["=COUNTA('Akun Terblokir'!B2:B)"]
    ];

    sheet.getRange(6, 2, 7, 1).setValues(labelMetrik).setFontWeight("bold");
    sheet.getRange(6, 3, 7, 1).setFormulas(rumusMetrik).setFontWeight("bold").setHorizontalAlignment("center");

    for(var r = 0; r < 7; r++) {
      var bgColor = (r % 2 === 0) ? "#e8f0fe" : "#ffffff"; 
      sheet.getRange(6 + r, 2, 1, 2).setBackground(bgColor);
    }

    sheet.getRange("B14").setValue("PANTAUAN KEAMANAN").setFontWeight("bold").setBackground("#b45f06").setFontColor("#ffffff");
    sheet.getRange("B14:C14").merge();
    
    sheet.getRange("B15").setValue("1 Gmail dipakai banyak HP").setBackground("#fce5cd");
    sheet.getRange("C15").setFormula("=COUNTIF('Data Ping'!J2:J; \">1\")").setBackground("#fce5cd").setHorizontalAlignment("center").setFontWeight("bold");

    sheet.getRange("B16").setValue("1 HP dipakai banyak Gmail").setBackground("#fff2cc");
    sheet.getRange("C16").setValue(0).setBackground("#fff2cc").setHorizontalAlignment("center").setFontWeight("bold"); 
    
    sheet.getRange("B18").setValue("KETERANGAN WARNA (DATA PING)").setFontWeight("bold").setBackground("#38761d").setFontColor("#ffffff");
    sheet.getRange("B18:C18").merge();
    
    var warnaInfo = [
      ["Hijau Terang", "Pembeli Permanen / Sekali Beli"], 
      ["Biru Terang", "Pembeli Bulanan"], 
      ["Cyan/Tosca", "Pembeli Aplikasi (30 Hari)"], 
      ["Hijau Pudar", "Akun Gratis (VIP/Spesial)"], 
      ["Abu-abu", "Expired / Habis Masa Aktif"], 
      ["Merah Terang", "DIBLOKIR / Ditolak!"]
    ];
    
    sheet.getRange(19, 2, 6, 2).setValues(warnaInfo);
    sheet.getRange(19,2,1,1).setBackground("#d9ead3"); sheet.getRange(20,2,1,1).setBackground("#c9daf8");
    sheet.getRange(21,2,1,1).setBackground("#d0e0e3"); sheet.getRange(22,2,1,1).setBackground("#e2f0d9");
    sheet.getRange(23,2,1,1).setBackground("#efefef"); sheet.getRange(24,2,1,1).setBackground("#f4cccc").setFontColor("red").setFontWeight("bold");
  }
  return sheet;
}


// ==============================================================================
// FUNGSI: CATAT DATA KEPKAT UTAMA
// ==============================================================================
function updateAtauSimpanData(sheet, nama, email, val1, val2, val3) {
  var data = sheet.getDataRange().getValues();
  var emailSudahAda = false;
  var statusPerangkat = (nama && nama.toString().trim() !== "-" && nama.toString().trim() !== "") ? "Terhubung" : "Belum Terhubung";
  
  for (var i = 1; i < data.length; i++) {
    if (data[i][2] && data[i][2].toString().toLowerCase().trim() === email) {
      sheet.getRange(i + 1, 2).setValue(nama); 
      sheet.getRange(i + 1, 4).setValue(val1); 
      sheet.getRange(i + 1, 5).setValue(val2); 
      sheet.getRange(i + 1, 6).setValue(val3); 
      if (statusPerangkat === "Terhubung") {
         sheet.getRange(i + 1, 7).setValue("Terhubung");
      }
      emailSudahAda = true;
      break;
    }
  }
  if (!emailSudahAda) {
    sheet.appendRow(["=ROW()-1", nama, email, val1, val2, val3, statusPerangkat]);
  }
}


// ==============================================================================
// FUNGSI: MENGHITUNG JUMLAH PEMBELIAN (Aplikasi / Bulanan)
// ==============================================================================
function simpanDataPaket(sheet, email, tanggalBeli, tanggalExpired) {
  var data = sheet.getDataRange().getValues();
  var emailSudahAda = false;
  for (var i = 1; i < data.length; i++) {
    if (data[i][1] && data[i][1].toString().toLowerCase().trim() === email) {
      sheet.getRange(i + 1, 3).setValue(tanggalBeli);
      sheet.getRange(i + 1, 4).setValue(tanggalExpired);
      var jumlahLama = parseInt(data[i][4]) || 1;
      sheet.getRange(i + 1, 5).setValue(jumlahLama + 1);
      emailSudahAda = true;
      break;
    }
  }
  if (!emailSudahAda) {
    sheet.appendRow(["=ROW()-1", email, tanggalBeli, tanggalExpired, 1]);
  }
}

// ==============================================================================
// FUNGSI KHUSUS: MENGHITUNG JUMLAH PEMBELIAN PERMANEN (Tanpa Expired)
// ==============================================================================
function simpanDataPaketPermanen(sheet, email, tanggalBeli) {
  var data = sheet.getDataRange().getValues();
  var emailSudahAda = false;
  for (var i = 1; i < data.length; i++) {
    if (data[i][1] && data[i][1].toString().toLowerCase().trim() === email) {
      sheet.getRange(i + 1, 3).setValue(tanggalBeli);
      var jumlahLama = parseInt(data[i][3]) || 1; 
      sheet.getRange(i + 1, 4).setValue(jumlahLama + 1);
      emailSudahAda = true;
      break;
    }
  }
  if (!emailSudahAda) {
    sheet.appendRow(["=ROW()-1", email, tanggalBeli, 1]);
  }
}

// ==============================================================================
// FUNGSI: PENCATATAN LOGIN (DATA PING)
// ==============================================================================
function catatLogin(email, statusFinal, deviceIdMasuk, namaMasuk, merekHpMasuk, versiAppMasuk) {
  var header = ["NO", "Nama", "Email", "Merek HP", "Versi App", "Waktu Terakhir Login", "Status Detail", "Total Ping", "Daftar ID HP", "Total HP Dipakai"];
  var sheetLogin = dapatkanAtauBuatTab(TAB_LOGIN, header);
 
  var data = sheetLogin.getDataRange().getValues();
  var barisDitemukan = -1;
  var arrayId = [];
  var isHpBaru = false;

  for (var i = 1; i < data.length; i++) {
    if (data[i][2] && data[i][2].toString().toLowerCase().trim() === email) {
      barisDitemukan = i + 1;
      var daftarIdLama = data[i][8] ? data[i][8].toString() : "";
      
      var tempArray = daftarIdLama === "" ? [] : daftarIdLama.split(", ");
      for (var x = 0; x < tempArray.length; x++) {
         if (tempArray[x].trim() !== "TIDAK_ADA_ID" && tempArray[x].trim() !== "") {
            arrayId.push(tempArray[x].trim());
         }
      }

      if (deviceIdMasuk && deviceIdMasuk !== "TIDAK_ADA_ID" && arrayId.indexOf(deviceIdMasuk) === -1) {
        arrayId.push(deviceIdMasuk);
        isHpBaru = true;
      }
      break;
    }
  }

  if (barisDitemukan === -1) {
    var initialId = (deviceIdMasuk && deviceIdMasuk !== "TIDAK_ADA_ID") ? deviceIdMasuk : "TIDAK_ADA_ID";
    sheetLogin.appendRow(["=ROW()-1", namaMasuk || "-", email, merekHpMasuk || "-", versiAppMasuk || "-", new Date(), statusFinal, 1, initialId, 1]);
    barisDitemukan = sheetLogin.getLastRow();
  } else {
    if (namaMasuk) sheetLogin.getRange(barisDitemukan, 2).setValue(namaMasuk); 
    
    if (merekHpMasuk && isHpBaru) {
        var daftarMerekLama = sheetLogin.getRange(barisDitemukan, 4).getValue().toString().trim(); 
        var arrayMerek = (daftarMerekLama === "" || daftarMerekLama === "-") ? [] : daftarMerekLama.split(", ");
        arrayMerek.push(merekHpMasuk);
        sheetLogin.getRange(barisDitemukan, 4).setValue(arrayMerek.join(", "));
    } else if (merekHpMasuk && !isHpBaru && sheetLogin.getRange(barisDitemukan, 4).getValue() === "-") {
        sheetLogin.getRange(barisDitemukan, 4).setValue(merekHpMasuk);
    }
    
    if (versiAppMasuk) sheetLogin.getRange(barisDitemukan, 5).setValue(versiAppMasuk); 
    sheetLogin.getRange(barisDitemukan, 6).setValue(new Date()); 
    sheetLogin.getRange(barisDitemukan, 7).setValue(statusFinal); 
    
    var bukaLama = parseInt(sheetLogin.getRange(barisDitemukan, 8).getValue()) || 0; 
    sheetLogin.getRange(barisDitemukan, 8).setValue(bukaLama + 1);
    
    var idUntukDitulis = arrayId.length > 0 ? arrayId.join(", ") : "TIDAK_ADA_ID";
    sheetLogin.getRange(barisDitemukan, 9).setValue(idUntukDitulis); 
    
    var jumlahHP = arrayId.length > 0 ? arrayId.length : 1;
    var cellJumlah = sheetLogin.getRange(barisDitemukan, 10); 
    cellJumlah.setValue(jumlahHP);
    
    if (jumlahHP > 1) {
        cellJumlah.setBackground("#f4cccc").setFontColor("#cc0000").setFontWeight("bold");
    } else {
        cellJumlah.setBackground(null).setFontColor(null).setFontWeight("normal");
    }
  }

  var rowRange = sheetLogin.getRange(barisDitemukan, 1, 1, header.length);
  rowRange.setFontColor("#000000").setFontWeight("normal");

  if (statusFinal.includes("Permanen") || statusFinal.includes("Langsung Tembus")) rowRange.setBackground("#d9ead3"); 
  else if (statusFinal.includes("Bulanan")) rowRange.setBackground("#c9daf8");
  else if (statusFinal.includes("Aplikasi")) rowRange.setBackground("#d0e0e3");
  else if (statusFinal.includes("Gratis") || statusFinal.includes("VIP")) rowRange.setBackground("#e2f0d9");
  else if (statusFinal.includes("Expired") || statusFinal.includes("Habis")) rowRange.setBackground("#efefef");
  else if (statusFinal === "BLOKIR" || statusFinal.includes("Belum Beli") || statusFinal.includes("Ditolak") || statusFinal.includes("Tidak Resmi")) rowRange.setBackground("#f4cccc").setFontColor("#cc0000").setFontWeight("bold");

  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheetDasbor = ss.getSheetByName(TAB_DASBOR);
  if (sheetDasbor) {
    var dataAkhir = sheetLogin.getDataRange().getValues();
    var pemetaanHP = {};
    for (var j = 1; j < dataAkhir.length; j++) {
        if (dataAkhir[j][2]) { 
            var emailBaris = dataAkhir[j][2].toString().trim();
            var daftarHpBaris = dataAkhir[j][8] ? dataAkhir[j][8].toString().split(", ") : [];
            for (var d = 0; d < daftarHpBaris.length; d++) {
                var idUnik = daftarHpBaris[d].trim();
                if (idUnik && idUnik !== "TIDAK TERBACA" && idUnik !== "TIDAK_ADA_ID") { 
                    if (!pemetaanHP[idUnik]) pemetaanHP[idUnik] = [];
                    if (pemetaanHP[idUnik].indexOf(emailBaris) === -1) {
                        pemetaanHP[idUnik].push(emailBaris);
                    }
                }
            }
        }
    }
    var hpPakaiBanyakAkun = 0;
    for (var key in pemetaanHP) {
        if (pemetaanHP[key].length > 1) hpPakaiBanyakAkun++;
    }
    
    var pencari = sheetDasbor.createTextFinder("1 HP dipakai banyak Gmail").matchEntireCell(true);
    var selDitemukan = pencari.findNext();
    if (selDitemukan) {
        var selUpdate = selDitemukan.offset(0, 1); 
        selUpdate.setValue(hpPakaiBanyakAkun);
        if (hpPakaiBanyakAkun > 0) {
            selUpdate.setFontColor("red");
        } else {
            selUpdate.setFontColor("black");
        }
    }
  }
}


// ==============================================================================
// GERBANG UTAMA: PENGECEKAN LISENSI DARI APLIKASI
// ==============================================================================
function doGet(e) {
  var tokenMasuk = e.parameter.token;
  if (tokenMasuk !== TOKEN_RAHASIA) {
    return ContentService.createTextOutput(JSON.stringify({status: "FORBIDDEN"})).setMimeType(ContentService.MimeType.JSON);
  }

  var sheetUtama = dapatkanAtauBuatTab(TAB_UTAMA, ["NO", "Nama", "Email", "Jenis Paket", "Tanggal Beli", "Tanggal Expired", "Status Perangkat"]);
  dapatkanAtauBuatTab(TAB_LOGIN, ["NO", "Nama", "Email", "Merek HP", "Versi App", "Waktu Terakhir Login", "Status Detail", "Total Ping", "Daftar ID HP", "Total HP Dipakai"]);
  dapatkanAtauBuatTab(TAB_BLOKIR, ["NO", "Target (Email / ID HP)", "Alasan Blokir"]);
  dapatkanAtauBuatTab(TAB_GRATIS, ["NO", "Email Gratis", "Keterangan"]);
  dapatkanAtauBuatTab(TAB_DASBOR, []); 

  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheetDasborSaklar = ss.getSheetByName(TAB_DASBOR);
  var statusSaklar = "BERBAYAR"; 
  if (sheetDasborSaklar) {
      var selSaklar = sheetDasborSaklar.getRange("C2").getValue(); 
      if(selSaklar) {
         var nilaiSaklar = selSaklar.toString().trim().toUpperCase();
         if (nilaiSaklar === "GRATIS") {
             statusSaklar = "GRATIS";
         }
      }
  }

  var emailToCheck = e.parameter.email ? e.parameter.email.toLowerCase().trim() : "";
  var deviceIdMasuk = e.parameter.deviceid ? e.parameter.deviceid.trim() : "TIDAK_ADA_ID";
  var namaMasuk = e.parameter.nama || "";
  var merekHpMasuk = e.parameter.merekhp || "";
  var versiAppMasuk = e.parameter.versiapp || "";
 
  if (!emailToCheck) {
    return ContentService.createTextOutput(JSON.stringify({status: "ERROR"})).setMimeType(ContentService.MimeType.JSON);
  }

  var waktuSekarang = new Date();
  var finalStatusDataLogin = "Tidak Diketahui";

  // 1. CEK BLOKIR
  var sheetBlokir = dapatkanAtauBuatTab(TAB_BLOKIR, []);
  var dataBlokir = sheetBlokir.getDataRange().getValues();
  for (var b = 1; b < dataBlokir.length; b++) {
    var targetBlokir = dataBlokir[b][1] ? dataBlokir[b][1].toString().toLowerCase().trim() : "";
    var jenisBlokir = targetBlokir.indexOf("@") !== -1 ? "EMAIL" : "DEVICE";

    if ((jenisBlokir === "EMAIL" && targetBlokir === emailToCheck) || 
        (jenisBlokir === "DEVICE" && targetBlokir === deviceIdMasuk.toLowerCase())) {
        catatLogin(emailToCheck, "BLOKIR", deviceIdMasuk, namaMasuk, merekHpMasuk, versiAppMasuk);
        return ContentService.createTextOutput(JSON.stringify({
           status: "BLOKIR", alasan: jenisBlokir
        })).setMimeType(ContentService.MimeType.JSON);
    }
  }

  // 2. CARI DATA DI PUSAT DATA 
  var dataUtama = sheetUtama.getDataRange().getValues();
  var emailDitemukan = false;
  var dataUser = null;

  for (var i = 1; i < dataUtama.length; i++) {
    if (dataUtama[i][2] && dataUtama[i][2].toString().toLowerCase().trim() === emailToCheck) {
      emailDitemukan = true;
      dataUser = dataUtama[i];

      var namaDiperbarui = false;
      if (namaMasuk && namaMasuk !== "" && namaMasuk !== "-" && (dataUtama[i][1] === "-" || dataUtama[i][1] === "")) {
         sheetUtama.getRange(i + 1, 2).setValue(namaMasuk);
         namaDiperbarui = true;
      }
      
      var namaSaatIni = namaDiperbarui ? namaMasuk : dataUtama[i][1].toString().trim();
      if (namaSaatIni !== "-" && namaSaatIni !== "") {
         if (dataUtama[i][6] !== "Terhubung") {
            sheetUtama.getRange(i + 1, 7).setValue("Terhubung");
         }
      }
      break;
    }
  }

  if (!emailDitemukan) {
    catatLogin(emailToCheck, "Ditolak (Gmail Tidak Terdaftar / Tidak Resmi)", deviceIdMasuk, namaMasuk, merekHpMasuk, versiAppMasuk);
    return ContentService.createTextOutput(JSON.stringify({
      status: "NEED_PACKAGE", tipe: "NONE", tanggal_expired_ms: 0
    })).setMimeType(ContentService.MimeType.JSON);
  }

  var sheetGratis = dapatkanAtauBuatTab(TAB_GRATIS, []);
  var dataGratis = sheetGratis.getDataRange().getValues();
  for (var g = 1; g < dataGratis.length; g++) {
    if (dataGratis[g][1] && dataGratis[g][1].toString().toLowerCase().trim() === emailToCheck) {
      catatLogin(emailToCheck, "Akses Gratis (VIP)", deviceIdMasuk, namaMasuk, merekHpMasuk, versiAppMasuk);
      return ContentService.createTextOutput(JSON.stringify({
        status: "SUCCESS", tipe: "GRATIS", tanggal_expired_ms: 0
      })).setMimeType(ContentService.MimeType.JSON);
    }
  }

  if (MODE_GRATIS_SEMUA || statusSaklar === "GRATIS") {
    catatLogin(emailToCheck, "Akses Gratis (Event Spesial)", deviceIdMasuk, namaMasuk, merekHpMasuk, versiAppMasuk);
    return ContentService.createTextOutput(JSON.stringify({
      status: "SUCCESS", tipe: "GRATIS", tanggal_expired_ms: 0
    })).setMimeType(ContentService.MimeType.JSON);
  }

  var jenisPaket = dataUser[3] ? dataUser[3].toString().toLowerCase().trim() : "";
  var tanggalExpiredRaw = dataUser[5] ? dataUser[5] : "";
  
  if (jenisPaket === "permanen" || jenisPaket === "bulanan") {
     var sheetAplikasi = ss.getSheetByName(TAB_APLIKASI);
     var pernahBeliAplikasi = false;
     
     if (sheetAplikasi) {
        var dataAplikasi = sheetAplikasi.getDataRange().getValues();
        for (var a = 1; a < dataAplikasi.length; a++) {
           if (dataAplikasi[a][1] && dataAplikasi[a][1].toString().toLowerCase().trim() === emailToCheck) {
              pernahBeliAplikasi = true;
              break;
           }
        }
     }
     
     if (!pernahBeliAplikasi) {
        catatLogin(emailToCheck, "Ditolak (Belum Beli Aplikasi)", deviceIdMasuk, namaMasuk, merekHpMasuk, versiAppMasuk);
        return ContentService.createTextOutput(JSON.stringify({
          status: "NEED_PACKAGE", tipe: "NONE", tanggal_expired_ms: 0
        })).setMimeType(ContentService.MimeType.JSON);
     }
  }
  
  if (jenisPaket === "permanen" || jenisPaket === "kepkat permanen") {
    catatLogin(emailToCheck, "Pembeli Permanen", deviceIdMasuk, namaMasuk, merekHpMasuk, versiAppMasuk);
    return ContentService.createTextOutput(JSON.stringify({
      status: "SUCCESS", tipe: "PERMANEN", tanggal_expired_ms: 0
    })).setMimeType(ContentService.MimeType.JSON);
  }
  
  var tanggalExpired = new Date(tanggalExpiredRaw);
  var isMasihAktif = waktuSekarang.getTime() <= tanggalExpired.getTime();

  if (jenisPaket === "aplikasi") {
     finalStatusDataLogin = isMasihAktif ? "Pembeli Aplikasi Aktif" : "Expired Aplikasi";
     catatLogin(emailToCheck, finalStatusDataLogin, deviceIdMasuk, namaMasuk, merekHpMasuk, versiAppMasuk);
     return ContentService.createTextOutput(JSON.stringify({
        status: isMasihAktif ? "SUCCESS" : "EXPIRED", tipe: "APLIKASI", tanggal_expired_ms: tanggalExpired.getTime()
     })).setMimeType(ContentService.MimeType.JSON);
  } else if (jenisPaket === "bulanan") {
     finalStatusDataLogin = isMasihAktif ? "Pembeli Bulanan Aktif" : "Expired Bulanan";
     catatLogin(emailToCheck, finalStatusDataLogin, deviceIdMasuk, namaMasuk, merekHpMasuk, versiAppMasuk);
     return ContentService.createTextOutput(JSON.stringify({
        status: isMasihAktif ? "SUCCESS" : "EXPIRED", tipe: "BULANAN", tanggal_expired_ms: tanggalExpired.getTime()
     })).setMimeType(ContentService.MimeType.JSON);
  }

  catatLogin(emailToCheck, "Tidak Ada Paket / Belum Beli", deviceIdMasuk, namaMasuk, merekHpMasuk, versiAppMasuk);
  return ContentService.createTextOutput(JSON.stringify({
    status: "NEED_PACKAGE", tipe: "NONE", tanggal_expired_ms: 0
  })).setMimeType(ContentService.MimeType.JSON);
}


// ==============================================================================
// GERBANG WEBHOOK LYNK.ID 
// ==============================================================================
function doPost(e) {
  var tokenMasuk = e.parameter.token;
  if (tokenMasuk !== TOKEN_RAHASIA) return ContentService.createTextOutput(JSON.stringify({status: "FORBIDDEN"})).setMimeType(ContentService.MimeType.JSON);

  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheetError = dapatkanAtauBuatTab(TAB_ERROR, ["NO", "Tipe Error", "Waktu", "Detail Pesan"]);

  try {
    var payload = JSON.parse(e.postData.contents);
    var emailPembeli = "";
    var namaPembeli = "-";
    
    if (payload && payload.data && payload.data.message_data && payload.data.message_data.customer) {
      emailPembeli = payload.data.message_data.customer.email ? payload.data.message_data.customer.email.toLowerCase().trim() : "";
      if (payload.data.message_data.customer.name && payload.data.message_data.customer.name.trim() !== "") {
         namaPembeli = payload.data.message_data.customer.name.trim();
      }
    }
    
    if (!emailPembeli) {
      sheetError.appendRow(["=ROW()-1", "Email Kosong / Tes Webhook", new Date(), JSON.stringify(payload)]);
      return ContentService.createTextOutput(JSON.stringify({status: "success"})).setMimeType(ContentService.MimeType.JSON);
    }

    if (namaPembeli === "" || namaPembeli === "-") {
      var sheetPing = ss.getSheetByName(TAB_LOGIN);
      if (sheetPing) {
        var dataPing = sheetPing.getDataRange().getValues();
        for (var p = 1; p < dataPing.length; p++) {
          if (dataPing[p][2] && dataPing[p][2].toString().toLowerCase().trim() === emailPembeli) {
            if (dataPing[p][1] && dataPing[p][1].toString().trim() !== "-" && dataPing[p][1].toString().trim() !== "") {
              namaPembeli = dataPing[p][1].toString().trim();
              break;
            }
          }
        }
      }
    }

    var sheetRiwayat = dapatkanAtauBuatTab(TAB_RIWAYAT, ["NO", "Waktu", "Email", "Nama Produk", "Kategori"]);
    var sheetUtama = dapatkanAtauBuatTab(TAB_UTAMA, ["NO", "Nama", "Email", "Jenis Paket", "Tanggal Beli", "Tanggal Expired", "Status Perangkat"]);
    var sheetAplikasi = dapatkanAtauBuatTab(TAB_APLIKASI, ["NO", "Email", "Tanggal Beli", "Tanggal Expired", "Jumlah Pembelian"]); 
    var sheetBulanan = dapatkanAtauBuatTab(TAB_BULANAN, ["NO", "Email", "Tanggal Beli", "Tanggal Expired", "Jumlah Pembelian"]);
    var sheetPermanen = dapatkanAtauBuatTab(TAB_PERMANEN, ["NO", "Email", "Tanggal Beli", "Jumlah Pembelian"]); 
    var sheetKepKatPermanen = dapatkanAtauBuatTab(TAB_KEPKAT_PERMANEN, ["NO", "Email", "Tanggal Beli", "Jumlah Pembelian"]); 
    var sheetLainnya = dapatkanAtauBuatTab(TAB_LAINNYA, ["NO", "Email", "Nama Produk", "Tanggal Beli"]);
   
    var produkDiproses = false;

    if (payload.data.message_data.items) {
      var daftarBarang = payload.data.message_data.items;
      for (var j = 0; j < daftarBarang.length; j++) {
        var namaProduk = daftarBarang[j].title.trim();
        var produkLower = namaProduk.toLowerCase();
       
        var isBulanan = produkLower.includes(PRODUK_LYNK_BULANAN.toLowerCase());
        var isPermanen = produkLower.includes(PRODUK_LYNK_PERMANEN.toLowerCase());
        var isUtama = produkLower.includes(PRODUK_LYNK_UTAMA.toLowerCase());
        var isKepKatPermanen = produkLower.includes(PRODUK_LYNK_KEPKAT_PERMANEN.toLowerCase()); 
       
        var waktuBeli = new Date();
        var kategoriDicatat = "";

        if (isKepKatPermanen) {
          updateAtauSimpanData(sheetUtama, namaPembeli, emailPembeli, "KepKat Permanen", waktuBeli, "-");
          simpanDataPaketPermanen(sheetKepKatPermanen, emailPembeli, waktuBeli); 
          kategoriDicatat = "KepKat Permanen (Langsung Tembus)";
          produkDiproses = true;
          
        } else if (isBulanan) {
          var waktuExpired = new Date(waktuBeli.getTime() + (MASA_AKTIF_BULANAN * 24 * 60 * 60 * 1000));
          updateAtauSimpanData(sheetUtama, namaPembeli, emailPembeli, "Bulanan", waktuBeli, waktuExpired);
          simpanDataPaket(sheetBulanan, emailPembeli, waktuBeli, waktuExpired); 
          kategoriDicatat = "Bulanan";
          produkDiproses = true;
         
        } else if (isPermanen) {
          updateAtauSimpanData(sheetUtama, namaPembeli, emailPembeli, "Permanen", waktuBeli, "-");
          simpanDataPaketPermanen(sheetPermanen, emailPembeli, waktuBeli); 
          kategoriDicatat = "Permanen";
          produkDiproses = true;
         
        } else if (isUtama) {
          var waktuExpiredUtama = new Date(waktuBeli.getTime() + (MASA_AKTIF_APLIKASI * 24 * 60 * 60 * 1000));
          updateAtauSimpanData(sheetUtama, namaPembeli, emailPembeli, "Aplikasi", waktuBeli, waktuExpiredUtama);
          simpanDataPaket(sheetAplikasi, emailPembeli, waktuBeli, waktuExpiredUtama); 
          kategoriDicatat = "Aplikasi (30 Hari)";
          produkDiproses = true;
          
        } else {
          sheetLainnya.appendRow(["=ROW()-1", emailPembeli, namaProduk, waktuBeli]);
          kategoriDicatat = "Lainnya (Tidak Dikenali)";
          produkDiproses = true;
        }
        sheetRiwayat.appendRow(["=ROW()-1", waktuBeli, emailPembeli, namaProduk, kategoriDicatat]);
      }
    }
    return ContentService.createTextOutput(JSON.stringify({status: "success"})).setMimeType(ContentService.MimeType.JSON);
  } catch(error) {
    sheetError.appendRow(["=ROW()-1", "Error Webhook Sistem", new Date(), error.toString()]);
    return ContentService.createTextOutput(JSON.stringify({status: "error"})).setMimeType(ContentService.MimeType.JSON);
  }
}
